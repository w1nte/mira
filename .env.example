# Settings for docker compose. Copy this file to .env and choose a password:
#   cp .env.example .env        (Windows: copy .env.example .env)
# Edit .env with any text editor (Notepad is fine). Docker Compose reads it as UTF-8, so don't
# create it with `echo ... > .env` in Windows PowerShell 5.1, which writes UTF-16.
VT_PASSWORD=choose-a-good-one
