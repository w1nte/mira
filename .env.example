# Settings for docker compose. Copy this file to .env and choose a password:
#   cp .env.example .env        (Windows: copy .env.example .env)
# Edit .env with any text editor (Notepad is fine). Docker Compose reads it as UTF-8, so don't
# create it with `echo ... > .env` in Windows PowerShell 5.1, which writes UTF-16.
VT_PASSWORD=choose-a-good-one

# --- HTTPS with Traefik (optional, see docs/remote.md) -------------------------------------
# Remove the "# " in front of the next three lines and fill in your domain and e-mail address.
# COMPOSE_FILE=docker-compose.yml:docker-compose.traefik.yml
# MIRA_DOMAIN=photos.example.com
# ACME_EMAIL=you@example.com
#
# Let's Encrypt uses the e-mail address only for notices about your certificate.
# To try the setup first without running into Let's Encrypt's rate limits, use their staging
# server (browsers warn about its certificate); remove the line again for the real one:
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
#
# Other ports on this server, e.g. when 80 and 443 are taken. Let's Encrypt still connects to
# port 443 from the internet, so forward it to TRAEFIK_HTTPS_PORT on your router.
# TRAEFIK_HTTP_PORT=80
# TRAEFIK_HTTPS_PORT=443
